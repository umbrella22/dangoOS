--- a/common/osi/fixed_queue.c
+++ b/common/osi/fixed_queue.c
@@ -147,10 +147,14 @@
 
     osi_mutex_lock(&queue->lock, OSI_MUTEX_MAX_TIMEOUT);
     status = list_append(queue->list, data); //Check whether enqueued success
-    osi_mutex_unlock(&queue->lock);
-
-    if(status == true )
+    /* Publish the dequeue credit before making the new list item visible to
+     * another task. A higher-priority HCI consumer can otherwise observe a
+     * nonempty list, fail its nonblocking dequeue and repost itself forever,
+     * starving the producer before it reaches osi_sem_give(). */
+    if (status) {
         osi_sem_give(&queue->dequeue_sem);
+    }
+    osi_mutex_unlock(&queue->lock);
 
     return status;
 }
