// EVE 风格风扇控制系统 - 主界面
// 设计版本: 嵌入式版 (480×480 AMOLED)
// 作者: Claude + Kiro
// 日期: 2024

import { VerticalBox, HorizontalBox } from "std-widgets.slint";

// ============================================
// 颜色定义（EVE 青金石蓝风格）
// ============================================
export global eve-colors {
    // 主色调
    out property <color> cyan-primary: #5fd0e0;      // 青金石蓝
    out property <color> amber-accent: #e8c25a;      // 琥珀金
    out property <color> green-ok: #7bc98a;          // 正常绿
    out property <color> red-warn: #e05d5d;          // 警告红
    
    // 背景色
    out property <color> bg-deep: #02060a;           // 深空黑
    out property <color> bg-panel: #0a1821;          // 面板背景
    out property <color> bg-panel-dark: #071119;     // 面板渐变底
    
    // 边框和文字
    out property <color> border-main: #6ebdd266;     // 半透明青色边框
    out property <color> border-accent: #6ebdd26e;   // 四角标记
    out property <color> text-primary: #c2dbe4;      // 主文字
    out property <color> text-secondary: #68838f;    // 次要文字
    out property <color> text-muted: #7895a1;        // 灰色文字
}

// ============================================
// 基础组件：EVE 风格面板
// ============================================
component EvePanel inherits Rectangle {
    // 输入属性
    in property <string> title: "";
    in property <bool> power-on: false;  // CRT 上电状态
    
    // 内部状态
    property <float> border-opacity: 0;
    property <float> content-opacity: 0;
    
    // 背景渐变
    background: @linear-gradient(180deg, eve-colors.bg-panel 0%, eve-colors.bg-panel-dark 100%);
    
    // 主边框
    border-width: 1px;
    border-color: eve-colors.border-main;
    border-radius: 0;
    
    // CRT 上电动画状态
    states [
        powered-up when power-on: {
            border-opacity: 1;
            content-opacity: 1;
            
            in {
                // 边框先闪（0.6秒）
                animate border-opacity {
                    duration: 600ms;
                    easing: ease-out;
                }
                // 内容后闪（0.8秒，延迟300ms）
                animate content-opacity {
                    delay: 300ms;
                    duration: 800ms;
                    easing: ease-out;
                }
            }
        }
    ]
    
    // 四角标记容器
    Rectangle {
        opacity: border-opacity;
        
        // 左上角
        Rectangle {
            x: -1px; y: -1px;
            width: 14px; height: 1px;
            background: eve-colors.border-accent;
        }
        Rectangle {
            x: -1px; y: -1px;
            width: 1px; height: 14px;
            background: eve-colors.border-accent;
        }
        
        // 右上角
        Rectangle {
            x: parent.width - 13px; y: -1px;
            width: 14px; height: 1px;
            background: eve-colors.border-accent;
        }
        Rectangle {
            x: parent.width; y: -1px;
            width: 1px; height: 14px;
            background: eve-colors.border-accent;
        }
        
        // 左下角
        Rectangle {
            x: -1px; y: parent.height;
            width: 14px; height: 1px;
            background: eve-colors.border-accent;
        }
        Rectangle {
            x: -1px; y: parent.height - 13px;
            width: 1px; height: 14px;
            background: eve-colors.border-accent;
        }
        
        // 右下角
        Rectangle {
            x: parent.width - 13px; y: parent.height;
            width: 14px; height: 1px;
            background: eve-colors.border-accent;
        }
        Rectangle {
            x: parent.width; y: parent.height - 13px;
            width: 1px; height: 14px;
            background: eve-colors.border-accent;
        }
    }
    
    // 内容容器
    VerticalLayout {
        opacity: content-opacity;
        padding: 16px;
        spacing: 8px;
        
        // 标题
        if title != "" : Text {
            text: title;
            color: eve-colors.cyan-primary;
            font-family: "Rajdhani";
            font-size: 13px;
            font-weight: 600;
        }
        
        // 分隔线
        if title != "" : Rectangle {
            height: 1px;
            background: #6ebdd222;
        }
        
        // 子内容插槽
        @children
    }
}

// ============================================
// 组件：六边形按钮
// ============================================
component HexButton inherits Rectangle {
    in property <int> value: 0;
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> is-auto: false;  // 是否为 AUTO 模式
    
    callback clicked();
    
    width: 24px;
    height: 28px;
    
    // 六边形路径（使用 Path）
    Path {
        fill: active ? (is-auto ? #7bc98a20 : #5fd0e020) : #0a1821;
        stroke: active ? (is-auto ? eve-colors.green-ok : eve-colors.cyan-primary) : 
                (is-auto ? #7bc98a66 : eve-colors.border-main);
        stroke-width: active ? 2px : 1.5px;
        
        // 正六边形坐标（无单位）
        MoveTo { x: 12; y: 0; }
        LineTo { x: 24; y: 6; }
        LineTo { x: 24; y: 22; }
        LineTo { x: 12; y: 28; }
        LineTo { x: 0; y: 22; }
        LineTo { x: 0; y: 6; }
        Close {}
        
        // 活动状态辉光动画
        // TODO: Slint 需要用 drop-shadow 或自定义滤镜实现辉光
    }
    
    // 数字/文字（修复：垂直居中）
    Text {
        text: value > 0 ? value : (is-auto ? "AUTO" : "0");
        color: active ? (is-auto ? eve-colors.green-ok : eve-colors.cyan-primary) : 
               (is-auto ? eve-colors.green-ok : eve-colors.text-secondary);
        font-family: "Arial";
        font-size: is-auto ? 8px : 12px;
        font-weight: active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    
    // 触摸区域
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// ============================================
// 组件：温度显示
// ============================================
component TempDisplay inherits VerticalLayout {
    in property <float> temperature: 28.5;
    in property <float> trend: 0.2;  // °C/分钟
    in property <float> warning-threshold: 60.0;
    
    spacing: 8px;
    
    // 传感器标签
    Text {
        text: "传感器-01";
        color: eve-colors.text-secondary;
        font-family: "Courier New";
        font-size: 10px;
    }
    
    // 温度大数字
    HorizontalLayout {
        spacing: 4px;
        
        Text {
            text: round(temperature * 10) / 10;
            color: eve-colors.cyan-primary;
            font-family: "Rajdhani";
            font-size: 36px;
            font-weight: 700;
        }
        
        Text {
            text: "°C";
            color: eve-colors.text-muted;
            font-family: "Rajdhani";
            font-size: 18px;
            vertical-alignment: center;
        }
    }
    
    // 温度条形图（修复：基于警告阈值而非 100°C）
    Rectangle {
        height: 8px;
        background: #1a2029;
        border-radius: 1px;
        
        Rectangle {
            width: parent.width * clamp(temperature / warning-threshold, 0, 1.2);
            height: parent.height;
            background: temperature < warning-threshold ? eve-colors.cyan-primary : eve-colors.amber-accent;
            border-radius: 1px;
        }
    }
    
    // 状态文字
    HorizontalLayout {
        spacing: 20px;
        
        Text {
            text: temperature < 50 ? "正常" : (temperature < 60 ? "升高" : "警告");
            color: temperature < 50 ? eve-colors.text-secondary : 
                   (temperature < 60 ? eve-colors.amber-accent : eve-colors.red-warn);
            font-family: "Courier New";
            font-size: 9px;
        }
        
        Text {
            text: "警告: " + warning-threshold + "°C";
            color: eve-colors.amber-accent;
            font-family: "Courier New";
            font-size: 9px;
        }
    }
    
    // 趋势指示
    Text {
        text: trend > 0 ? "▲ +" + round(trend * 10) / 10 + "°C/分钟" :
              trend < 0 ? "▼ " + round(trend * 10) / 10 + "°C/分钟" :
              "● 稳定";
        color: trend > 0 ? eve-colors.green-ok :
               trend < 0 ? #6fb7ff :
               eve-colors.text-secondary;
        font-family: "Courier New";
        font-size: 9px;
    }
}

// ============================================
// 组件：转速显示（带圆环）
// ============================================
component RpmDisplay inherits VerticalLayout {
    in property <int> rpm: 2450;
    in property <int> percentage: 75;
    in property <float> power: 6.0;
    
    spacing: 8px;
    
    // 风扇标签
    Text {
        text: "风扇-01";
        color: eve-colors.text-secondary;
        font-family: "Courier New";
        font-size: 10px;
    }
    
    // 转速数字和圆环
    HorizontalLayout {
        spacing: 20px;
        
        // 左侧：转速数字
        VerticalLayout {
            spacing: 0;
            
            Text {
                text: rpm;
                color: eve-colors.amber-accent;
                font-family: "Rajdhani";
                font-size: 32px;
                font-weight: 700;
            }
            
            Text {
                text: "RPM";
                color: eve-colors.text-muted;
                font-family: "Arial";
                font-size: 12px;
            }
        }
        
        // 右侧：圆形百分比（简化版圆环）
        Rectangle {
            width: 80px;
            height: 80px;
            
            // 使用旋转的 Rectangle 模拟圆环（临时方案）
            Rectangle {
                width: 70px;
                height: 70px;
                border-radius: 35px;
                border-width: 6px;
                border-color: #1a2029;
                background: transparent;
            }
            
            // 进度指示（使用渐变色模拟）
            Rectangle {
                width: 70px;
                height: 70px;
                border-radius: 35px;
                border-width: 6px;
                border-color: percentage > 0 ? eve-colors.amber-accent : transparent;
                background: transparent;
                
                // 通过裁剪模拟进度
                clip: true;
            }
            
            // 百分比文字
            Text {
                text: percentage + "%";
                color: eve-colors.amber-accent;
                font-family: "Rajdhani";
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    
    // 底部信息
    HorizontalLayout {
        spacing: 20px;
        
        Text {
            text: "功率: " + round(power * 10) / 10 + "W";
            color: eve-colors.text-secondary;
            font-family: "Courier New";
            font-size: 9px;
        }
        
        Text {
            text: "效率: 最优";
            color: eve-colors.green-ok;
            font-family: "Courier New";
            font-size: 9px;
        }
    }
}

// ============================================
// 主界面：风扇控制系统
// ============================================
export component FanControlUI inherits Window {
    title: "EVE 风扇控制系统";
    width: 480px;
    height: 480px;
    background: eve-colors.bg-deep;
    
    // ========================================
    // 数据属性（绑定到 Rust 后端）
    // ========================================
    
    // 温度数据
    in-out property <float> temperature: 28.5;     // 当前温度 (°C)
    in-out property <float> temp-trend: 0.2;       // 温度趋势 (°C/分钟)
    
    // 转速数据
    in-out property <int> fan-rpm: 2450;           // 当前转速 (RPM)
    in-out property <int> fan-percentage: 75;      // 转速百分比
    in-out property <float> fan-power: 6.0;        // 功率 (W)
    
    // 系统状态
    in-out property <string> uptime: "00:00:00";   // 运行时间
    in-out property <int> cpu-temp: 42;            // CPU 温度 (°C)
    in-out property <bool> system-online: true;    // 系统在线状态
    
    // 风扇控制
    in-out property <int> target-speed: 75;        // 目标档位 (0/25/50/75/100/-1=AUTO)
    
    // CRT 上电状态（默认关闭，由 Rust 触发动画）
    in-out property <bool> panel-1-on: false;
    in-out property <bool> panel-2-on: false;
    in-out property <bool> panel-3-on: false;
    in-out property <bool> panel-4-on: false;
    in-out property <bool> panel-5-on: false;
    in-out property <bool> panel-6-on: false;
    
    // ========================================
    // 回调（Rust 调用）
    // ========================================
    callback speed-changed(int);  // 档位改变回调
    
    // ========================================
    // 主布局
    // ========================================
    VerticalLayout {
        padding: 10px;
        spacing: 15px;
        
        // ====================================
        // 标题栏
        // ====================================
        HorizontalLayout {
            height: 40px;
            
            VerticalLayout {
                spacing: 2px;
                
                Text {
                    text: "热管理控制系统";
                    color: eve-colors.cyan-primary;
                    font-family: "Arial";
                    font-size: 18px;
                    font-weight: 700;
                }
                
                Text {
                    text: "ESP-MOSAICO · S31 · V0.2.0";
                    color: eve-colors.text-secondary;
                    font-family: "Courier New";
                    font-size: 11px;
                }
            }
        }
        
        // ====================================
        // 系统状态栏（修复：单行水平布局）
        // ====================================
        EvePanel {
            height: 50px;
            title: "系统状态";
            power-on: panel-1-on;
            
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;
                
                Text {
                    text: "运行时间: " + uptime;
                    color: eve-colors.text-primary;
                    font-family: "Courier New";
                    font-size: 11px;
                }
                
                Text {
                    text: "CPU: " + cpu-temp + "°C";
                    color: eve-colors.text-primary;
                    font-family: "Courier New";
                    font-size: 11px;
                }
                
                HorizontalLayout {
                    spacing: 8px;
                    
                    Text {
                        text: "[ 在线 ]";
                        color: eve-colors.green-ok;
                        font-family: "Arial";
                        font-size: 11px;
                    }
                    
                    // 在线指示灯
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: system-online ? eve-colors.green-ok : eve-colors.text-secondary;
                    }
                }
            }
        }
        
        // ====================================
        // 监控面板行（调整高度避免溢出）
        // ====================================
        HorizontalLayout {
            spacing: 20px;
            height: 150px;  // 从 160px 减少到 150px
            
            // 温度监控面板
            EvePanel {
                width: 220px;
                title: "温度监控";
                power-on: panel-2-on;
                
                TempDisplay {
                    temperature: root.temperature;
                    trend: root.temp-trend;
                    warning-threshold: 60.0;
                }
            }
            
            // 转速监控面板
            EvePanel {
                width: 220px;
                title: "转速监控";
                power-on: panel-3-on;
                
                RpmDisplay {
                    rpm: root.fan-rpm;
                    percentage: root.fan-percentage;
                    power: root.fan-power;
                }
            }
        }
        
        // ====================================
        // 风扇控制面板（减小高度）
        // ====================================
        EvePanel {
            height: 100px;  // 从 120px 减少到 100px
            title: "风扇控制";
            power-on: panel-4-on;
            
            // 六边形按钮组
            // 六边形档位按钮（6个：0/25/50/75/100/AUTO）
            HorizontalLayout {
                spacing: 50px;
                padding-top: 10px;  // 从 20px 减少到 10px
                alignment: center;
                
                // 0% 停止
                HexButton {
                    value: 0;
                    active: root.target-speed == 0;
                    clicked => {
                        root.target-speed = 0;
                        root.speed-changed(0);
                    }
                }
                
                // 25% 低速
                HexButton {
                    value: 25;
                    active: root.target-speed == 25;
                    clicked => {
                        root.target-speed = 25;
                        root.speed-changed(25);
                    }
                }
                
                // 50% 中速
                HexButton {
                    value: 50;
                    active: root.target-speed == 50;
                    clicked => {
                        root.target-speed = 50;
                        root.speed-changed(50);
                    }
                }
                
                // 75% 高速
                HexButton {
                    value: 75;
                    active: root.target-speed == 75;
                    clicked => {
                        root.target-speed = 75;
                        root.speed-changed(75);
                    }
                }
                
                // 100% 全速
                HexButton {
                    value: 100;
                    active: root.target-speed == 100;
                    clicked => {
                        root.target-speed = 100;
                        root.speed-changed(100);
                    }
                }
                
                // AUTO 自动
                HexButton {
                    value: 0;
                    is-auto: true;
                    active: root.target-speed == -1;
                    clicked => {
                        root.target-speed = -1;
                        root.speed-changed(-1);
                    }
                }
            }
        }
        
        // ====================================
        // 底部状态栏
        // ====================================
        Rectangle {
            height: 20px;
            
            Rectangle {
                width: parent.width;
                height: 1px;
                background: #6ebdd222;
            }
            
            HorizontalLayout {
                padding-top: 5px;
                
                Text {
                    text: "MOSAICO-S31";
                    color: eve-colors.text-secondary;
                    font-family: "Courier New";
                    font-size: 9px;
                }
                
                Rectangle { width: 1px; }
                
                Text {
                    text: "2026-09-08";  // TODO: 动态日期
                    color: eve-colors.text-secondary;
                    font-family: "Courier New";
                    font-size: 9px;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
