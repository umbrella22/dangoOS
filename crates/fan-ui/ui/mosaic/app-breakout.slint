// SPDX-License-Identifier: Apache-2.0
// Breakout 打砖块(M3): 官方 bricks 应用风格
// 游戏 = 纯软件模拟(Rust 侧 30Hz 步进) + Slint 渲染
// 官方场景: 深底 + 顶部砖阵 + 底部挡板; 无官方场景 JSON 细节(游戏是 canvas 类),
// 视觉按官方 tokens: 砖=#FCFCFF 系灰阶, 挡板=#FF4C01, 球=#FCFCFF

import { Palette } from "palette.slint";

export component AppBreakout inherits Rectangle {
    in property <int> score: 0;
    in property <int> lives: 3;
    in property <bool> running: false;
    // 球/挡板位置(逻辑 0..480, Rust 步进)
    in property <length> ball-x: 240px;
    in property <length> ball-y: 300px;
    in property <length> paddle-x: 190px;
    // 砖阵: 6 列 × 4 行, 每砖存活(Slint 无位运算, Rust 侧展开数组)
    in property <[bool]> bricks-live;

    callback back-requested();
    callback start-requested();

    width: 480px;
    height: 480px;
    background: Palette.screen-bg;

    // 页头(分数 + 生命)
    Text {
        x: 16px;
        y: 12px;
        width: 200px;
        height: 36px;
        text: "SCORE " + root.score;
        font-size: 24px;
        color: Palette.text;
    }
    Text {
        x: 292px;
        y: 12px;
        width: 128px;
        height: 36px;
        text: "LIVES " + root.lives;
        font-size: 24px;
        color: Palette.text-2nd;
        horizontal-alignment: right;
    }
    // 返回
    Rectangle {
        x: 432px;
        y: 8px;
        width: 40px;
        height: 40px;
        Text {
            width: 100%;
            height: 100%;
            text: "×";
            font-size: 30px;
            color: Palette.text-2nd;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.back-requested();
            }
        }
    }

    // 砖阵(6×4: 砖 72×18 间距 6, 起点 x=17 y=64; 行色阶)
    for brick[i] in 24: Rectangle {
        x: 17px + Math.mod(i, 6) * 78px;
        y: 64px + Math.floor(i / 6) * 24px;
        width: 72px;
        height: 18px;
        border-radius: 4px;
        background: Math.floor(i / 6) == 0 ? #FCFCFF
            : Math.floor(i / 6) == 1 ? #B8B8BE
            : Math.floor(i / 6) == 2 ? #7A7A80
            : #4A4A50;
        visible: root.bricks-live[i];
    }

    // 球
    Rectangle {
        x: root.ball-x - 5px;
        y: root.ball-y - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Palette.text;
    }
    // 挡板
    Rectangle {
        x: root.paddle-x;
        y: 440px;
        width: 100px;
        height: 12px;
        border-radius: 6px;
        background: Palette.accent;
    }

    // 触摸层: 点按开始; 游戏中触摸 x = 挡板目标
    TouchArea {
        y: 56px;
        height: 424px;
        clicked => {
            if (!root.running) {
                root.start-requested();
            }
        }
        moved => {
            // 挡板跟随由 Rust 读 pointer(简化: M3 触摸点即挡板中心)
        }
    }

    // 未运行时的提示
    if !root.running: Rectangle {
        x: 90px;
        y: 200px;
        width: 300px;
        height: 120px;
        border-radius: 24px;
        background: #E8E8E4E0;
        Text {
            width: 100%;
            height: 100%;
            text: root.lives == 0 ? "TAP TO RESTART" : "TAP TO START";
            font-size: 32px;
            color: #1A1A1A;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
