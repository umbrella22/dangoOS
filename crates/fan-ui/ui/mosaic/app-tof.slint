// SPDX-License-Identifier: Apache-2.0
// TOF 测距页 = 官方 build_tof_page(场景 JSON 逐像素)
// 大卡 r40 + 120px 英雄数字 + 标尺刻度 + 阈值滑杆 + VALID 徽标
// 模块未插入时英雄数字显示 "--"(模块热插拔检测 M4+ 经 module_mgr)

import { Palette } from "palette.slint";

export component AppTof inherits Rectangle {
    in property <string> distance: "--"; // cm
    in property <int> threshold: 50;
    in property <bool> valid: false;

    callback back-requested();
    callback threshold-changed(int);

    width: 480px;
    height: 480px;
    background: Palette.screen-bg;

    // 大卡(官方 12,12 456x456 r40)
    Rectangle {
        x: 12px;
        y: 12px;
        width: 456px;
        height: 456px;
        border-radius: 40px;
        background: Palette.card;

        // 页头(卡片内)
        Rectangle {
            x: 0px;
            y: 0px;
            width: 96px;
            height: 64px;
            Text {
                x: 24px;
                y: 8px;
                width: 48px;
                height: 48px;
                text: "‹";
                font-size: 36px;
                color: Palette.text-2nd;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.back-requested();
                }
            }
        }
        // 英雄数字(官方 120px bold @(20,96) 360x130)
        Text {
            x: 20px;
            y: 96px;
            width: 360px;
            height: 130px;
            text: root.distance;
            font-size: 120px;
            color: Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 360px;
            y: 200px;
            width: 60px;
            height: 30px;
            text: "cm";
            font-size: 20px;
            color: Palette.text-2nd;
        }
        // 标尺刻度(官方 y=300: 0/25/50/75/100)
        Text {
            x: 16px;
            y: 300px;
            width: 40px;
            height: 28px;
            text: "0";
            font-size: 20px;
            color: #E1E4E9;
            horizontal-alignment: center;
        }
        Text {
            x: 100px;
            y: 300px;
            width: 40px;
            height: 28px;
            text: "25";
            font-size: 20px;
            color: #E1E4E9;
            horizontal-alignment: center;
        }
        Text {
            x: 190px;
            y: 300px;
            width: 40px;
            height: 28px;
            text: "50";
            font-size: 20px;
            color: #E1E4E9;
            horizontal-alignment: center;
        }
        Text {
            x: 290px;
            y: 300px;
            width: 40px;
            height: 28px;
            text: "75";
            font-size: 20px;
            color: #E1E4E9;
            horizontal-alignment: center;
        }
        Text {
            x: 390px;
            y: 300px;
            width: 40px;
            height: 28px;
            text: "100";
            font-size: 20px;
            color: #E1E4E9;
            horizontal-alignment: center;
        }
        Text {
            x: 16px;
            y: 328px;
            width: 120px;
            height: 22px;
            text: "Threshold";
            font-size: 16px;
            color: Palette.text-2nd;
        }
        // 阈值滑杆(官方 16,352 414x20, 橙色)
        Rectangle {
            x: 16px;
            y: 352px;
            width: 414px;
            height: 20px;
            Rectangle {
                y: 5px;
                width: 100%;
                height: 10px;
                border-radius: 5px;
                background: Palette.capsule;
            }
            Rectangle {
                y: 5px;
                width: root.threshold / 100 * 414px;
                height: 10px;
                border-radius: 5px;
                background: Palette.accent;
            }
            Rectangle {
                x: root.threshold / 100 * 414px - 11px;
                y: 0px;
                width: 22px;
                height: 20px;
                border-radius: 10px;
                background: Palette.text;
            }
            TouchArea {
                moved => {
                    if self.pressed { root.threshold-changed(Math.clamp(self.mouse-x / self.width * 100, 0, 100)); }
                }
                clicked => {
                    root.threshold-changed(Math.clamp(self.mouse-x / self.width * 100, 0, 100));
                }
            }
        }
        // VALID 徽标(官方 188,374 80x32 橙底)
        Rectangle {
            x: 188px;
            y: 374px;
            width: 80px;
            height: 32px;
            background: root.valid ? Palette.accent : Palette.capsule;
            Text {
                width: 100%;
                height: 100%;
                text: root.valid ? "VALID" : "WAIT";
                font-size: 20px;
                color: Palette.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
