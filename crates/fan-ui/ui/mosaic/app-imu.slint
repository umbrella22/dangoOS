// SPDX-License-Identifier: Apache-2.0
// IMU 水平仪页 = 官方 build_imu_page(场景 JSON 逐像素)
// 亮色表盘 #F9FAFB r43 + 十字线 + 琥珀气泡 76px(位置由 pitch/roll 驱动) + 三张数据卡

import { Palette } from "palette.slint";

export component AppImu inherits Rectangle {
    // 气泡左上角(全屏坐标)，水平时中心与表盘十字线重合
    in property <length> bubble-x: 202px;
    in property <length> bubble-y: 166.5px;
    in property <bool> valid: false;
    in property <string> angle: "0°";
    in property <string> pitch: "0";
    in property <string> roll: "0";
    in property <string> yaw: "--";

    callback back-requested();

    width: 480px;
    height: 480px;
    background: Palette.screen-bg;

    // 页头
    Rectangle {
        x: 0px;
        y: 0px;
        width: 96px;
        height: 64px;
        Text {
            x: 24px;
            y: 8px;
            width: 48px;
            height: 48px;
            text: "‹";
            font-size: 36px;
            color: Palette.text-2nd;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.back-requested();
            }
        }
    }
    Text {
        x: 0px;
        y: 0px;
        width: 480px;
        height: 64px;
        text: "IMU";
        font-size: 24px;
        color: Palette.text-2nd;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 水平仪表盘(官方 12,74 456x261 r43 亮色)
    Rectangle {
        x: 12px;
        y: 74px;
        width: 456px;
        height: 261px;
        border-radius: 43px;
        background: #F9FAFB;
        clip: true;

        // 十字线(官方两条 2px 黑线)
        Rectangle {
            x: 0px;
            y: 130px;
            width: 456px;
            height: 2px;
            background: #000000;
        }
        Rectangle {
            x: 227px;
            y: 0px;
            width: 2px;
            height: 261px;
            background: #000000;
        }
        // 气泡(官方 76px 琥珀 #FFB020 r38, 位置运行时驱动)
        Rectangle {
            x: root.bubble-x - 12px;
            y: root.bubble-y - 74px;
            width: 76px;
            height: 76px;
            border-radius: 38px;
            background: root.valid ? Palette.warn-amber : Palette.capsule;
            Text {
                width: 100%;
                height: 48px;
                y: 14px;
                text: root.valid ? root.angle : "--";
                font-size: 36px;
                color: Palette.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // 三张数据卡(官方 141x106 r20 @y351: Pitch/Roll/Yaw)
    Rectangle {
        x: 12px;
        y: 351px;
        width: 141px;
        height: 106px;
        border-radius: 20px;
        background: Palette.card;
        border-width: 1px;
        border-color: Palette.capsule;
        Text {
            y: 16px;
            width: 100%;
            height: 22px;
            text: "Pitch";
            font-size: 16px;
            color: Palette.text-2nd;
            horizontal-alignment: center;
        }
        Text {
            y: 42px;
            width: 100%;
            height: 50px;
            text: root.valid ? root.pitch : "--";
            font-size: 48px;
            color: Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 170px;
        y: 351px;
        width: 141px;
        height: 106px;
        border-radius: 20px;
        background: Palette.card;
        border-width: 1px;
        border-color: Palette.capsule;
        Text {
            y: 16px;
            width: 100%;
            height: 22px;
            text: "Roll";
            font-size: 16px;
            color: Palette.text-2nd;
            horizontal-alignment: center;
        }
        Text {
            y: 42px;
            width: 100%;
            height: 50px;
            text: root.valid ? root.roll : "--";
            font-size: 48px;
            color: Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 327px;
        y: 351px;
        width: 141px;
        height: 106px;
        border-radius: 20px;
        background: Palette.card;
        border-width: 1px;
        border-color: Palette.capsule;
        Text {
            y: 16px;
            width: 100%;
            height: 22px;
            text: "Yaw";
            font-size: 16px;
            color: Palette.text-2nd;
            horizontal-alignment: center;
        }
        Text {
            y: 42px;
            width: 100%;
            height: 50px;
            text: root.yaw;
            font-size: 48px;
            color: Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
