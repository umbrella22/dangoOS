// 官方锁屏(M2): AOD 模式 = 深底 + 日期行 + 144px 大时钟 + 上滑提示 + CHRG 徽标
// 布局取自 hub 场景 JSON lock_screen_aod 子树
// 唤醒/睡眠: platform 层把 AI 键(低有效 GPIO7) 映射为 lock 切换

import { Palette } from "palette.slint";

export component LockScreen inherits Rectangle {
    in property <string> time: "12:00";
    in property <string> date-prefix: "7/20 · ";
    in property <string> date-day: "Mon";
    in property <bool> charging: false;

    callback unlock-requested();

    width: 480px;
    height: 480px;
    background: #050505;

    Text {
        x: 80px;
        y: 68px;
        width: 173px;
        height: 34px;
        text: root.date-prefix;
            horizontal-alignment: right;
        font-size: 26px;
        color: Palette.text;
    }
    Text {
        x: 253px;
        y: 68px;
        width: 147px;
        height: 34px;
        text: root.date-day;
        font-size: 26px;
        color: Palette.accent;
    }
    Text {
        x: 0px;
        y: 92px;
        width: 480px;
        height: 144px;
        text: root.time;
        font-size: 144px;
        color: Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // CHRG 徽标(充电中显示; 官方 aod_show_charge 86x44 r22 @382,12)
    Rectangle {
        x: 382px;
        y: 12px;
        width: 86px;
        height: 44px;
        border-radius: 22px;
        background: Palette.card;
        visible: root.charging;
        Text {
            width: 100%;
            height: 100%;
            text: "CHRG";
            font-size: 20px;
            color: Palette.ok-green;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // 上滑提示(上滑手势 M2 用 TouchArea 的 moved 近似: 按住上移 60px 解锁)
    Image {
        x: 228px;
        y: 408px;
        width: 24px;
        height: 24px;
        source: @image-url("assets/icons/up_chevron.png");
    }
    Text {
        x: 0px;
        y: 438px;
        width: 480px;
        height: 28px;
        text: "Swipe up to open";
        font-size: 24px;
        color: Palette.text-2nd;
        horizontal-alignment: center;
    }
    Rectangle {
        width: 480px;
        height: 480px;
        background: transparent;
        TouchArea {
            moved => {
                if self.pressed && self.pressed-y - self.mouse-y >= 60px {
                    root.unlock-requested();
                }
            }
        }
    }
}
