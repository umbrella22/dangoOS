// 官方 Mosaico UI 设计 tokens
// 来源: esp-mosaico-claw components/mosaic_ui/common/scene_common.py
// 文档: docs/MOSAICO_UI_DESIGN.md §1

export global Palette {
    // 屏幕
    out property <color> screen-bg: #000000;

    // 文字
    out property <color> text: #FCFCFF;       // 主文字
    out property <color> text-2nd: #91919B;   // 次级标签/说明
    out property <color> text-dim: #595959;   // 提示/chevron
    out property <color> text-title: #D6D6DE; // 页面标题/次要项

    // 强调色
    out property <color> accent: #FF4C01;     // 官方品牌橙(唯一强调色)
    out property <color> ok-green: #63C270;   // 充电/有效
    out property <color> warn-amber: #FFB020; // 警告/水平泡
    out property <color> danger: #FF0000;     // 低电量

    // 表面
    out property <color> card: #181819;       // 列表行/数据卡
    out property <color> card-hi: #282829;    // 按钮亮底
    out property <color> hub-card: #242425;   // Hub 顶部大卡
    out property <color> capsule: #3B3C3D;    // 通知胶囊/工具条
    out property <color> capsule-border: #9A9A9F;
    out property <color> drawer-bg: #272727;
    out property <color> level-fill: #EDEFF2;
    // Adjustable layout assumption, not a measured physical panel radius.
    out property <length> screen-corner-radius: 60px;
    out property <color> shade: #101011;      // 下拉面板底

    // Atelier 时钟
    out property <color> clock-hand: #202124;
    out property <color> clock-face: #E8E8E4;
    out property <color> clock-ring-dark: #5B5D60;
    out property <color> clock-ring-mid: #9A9B9C;
    out property <color> weather-city: #B7B7BE;
}
