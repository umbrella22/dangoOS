// Official Control Center assets/behaviors; compact layout for corner safety.
// Upstream provenance and asset hashes: assets/control_center/SOURCE.txt.

import { Palette } from "palette.slint";
import { StatusBar } from "status-bar.slint";

component Tile inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <length> glyph-size: 45px;
    callback requested();
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background: root.active ? Palette.accent : Palette.capsule;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        image-fit: contain;
        source: root.icon;
    }
    TouchArea {
        clicked => {
            if Math.abs(self.mouse-x - self.pressed-x) <= 12px
                && Math.abs(self.mouse-y - self.pressed-y) <= 12px {
                root.requested();
            }
        }
    }
}

// A flat fill plus the vendor antialiased outer mask. SoftwareRenderer ignores
// rounded Rectangle clipping; the native 72×152 mask reliably preserves caps.
component VSlider inherits Rectangle {
    in property <int> value: 50;
    in property <image> icon;
    in property <length> glyph-size: 40px;
    callback changed(int);
    width: 72px;
    height: 152px;
    background: Palette.capsule;
    public function update-level(pointer-y: length) {
        root.changed(Math.clamp((1 - pointer-y / root.height) * 100, 0, 100));
    }
    Rectangle {
        y: (1 - Math.clamp(root.value, 0, 100) / 100) * root.height;
        width: root.width;
        height: Math.clamp(root.value, 0, 100) / 100 * root.height;
        background: Palette.level-fill;
    }
    Image {
        width: root.width;
        height: root.height;
        source: @image-url("assets/control_center/capsule_mask_72.png");
    }
    Image {
        x: (root.width - self.width) / 2;
        y: root.height - 13px - self.height;
        width: root.glyph-size;
        height: root.glyph-size;
        image-fit: contain;
        source: root.icon;
    }
    TouchArea {
        moved => { if self.pressed { root.update-level(self.mouse-y); } }
        clicked => { root.update-level(self.mouse-y); }
    }
}

export component QuickDrawer inherits Rectangle {
    in property <string> status-time;
    in property <int> wifi-level;
    in property <int> battery-pct;
    in property <bool> charging;
    in property <bool> wlan-on;
    in property <bool> bt-on;
    in property <int> volume;
    in property <int> brightness;
    in property <image> slot-l-icon;
    in property <image> slot-r-icon;
    in property <bool> has-slots;
    in property <string> feedback-text;

    // 0=WiFi 1=Join 2=BT 3=LowPower 4=Ringtone 5=Vibration 6=Music.
    // Availability/state comes from runtime; a request never fabricates ON.
    callback control-requested(int);
    callback slot-requested(int); // 0=LEFT 1=RIGHT
    callback volume-changed(int);
    callback brightness-changed(int);
    callback dismissed();
    width: 480px;
    height: 480px;
    background: Palette.drawer-bg;

    // 识别容器消费已确认的上滑及其释放；普通点击继续交给磁贴/把手。
    drawer-gesture := SwipeGestureHandler {
        x: 0px;
        y: 0px;
        width: 480px;
        height: 480px;
        // 手指起于滑杆时，该 contact 始终属于滑杆，即使后来移出轨道。
        private property <bool> slider-origin:
            self.pressed-position.y >= level-group.y + volume-slider.y
            && self.pressed-position.y < level-group.y + volume-slider.y + volume-slider.height
            && ((self.pressed-position.x >= level-group.x + volume-slider.x
                    && self.pressed-position.x < level-group.x + volume-slider.x + volume-slider.width)
                || (self.pressed-position.x >= level-group.x + brightness-slider.x
                    && self.pressed-position.x < level-group.x + brightness-slider.x + brightness-slider.width));
        private property <bool> brightness-origin: self.slider-origin
            && self.pressed-position.x >= level-group.x + brightness-slider.x;
        handle-swipe-up: true;
        handle-swipe-down: self.slider-origin;
        handle-swipe-left: self.slider-origin;
        handle-swipe-right: self.slider-origin;
        function update-slider() {
            if self.brightness-origin {
                brightness-slider.update-level(self.current-position.y - level-group.y - brightness-slider.y);
            } else {
                volume-slider.update-level(self.current-position.y - level-group.y - volume-slider.y);
            }
        }
        moved => {
            if self.swiping && self.slider-origin { self.update-slider(); }
        }
        swiped => {
            if self.slider-origin {
                self.update-slider();
            } else if self.pressed-position.y - self.current-position.y >= 60px
                && self.pressed-position.y - self.current-position.y
                    >= Math.abs(self.current-position.x - self.pressed-position.x) * 1.5 {
                root.dismissed();
            }
        }
        // 消费空白区域的触摸，子控件仍在此屏障之上接收输入。
        TouchArea {}

        // A 48px chrome band leaves more usable content below. Feedback
        // temporarily replaces the status row and never covers hit targets.
        StatusBar {
            y: -4px;
            height: 48px;
            time: root.status-time;
            wifi-level: root.wifi-level;
            battery-pct: root.battery-pct;
            charging: root.charging;
            visible: root.feedback-text == "";
        }
        Text {
            x: 40px;
            y: 8px;
            width: 400px;
            height: 36px;
            text: root.feedback-text;
            visible: root.feedback-text != "";
            font-size: 18px;
            color: Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: 24px;
            y: 48px;
            width: 208px;
            height: 270px;
            border-radius: 60px;
            background: Palette.card;
            Tile {
                x: 16px; y: 8px;
                icon: root.wlan-on ? @image-url("assets/control_center/wifi_active.png")
                    : @image-url("assets/control_center/wifi.png");
                active: root.wlan-on;
                requested => { root.control-requested(0); }
            }
            Tile {
                x: 120px; y: 8px;
                glyph-size: 48px;
                icon: @image-url("assets/control_center/airdrop.png");
                requested => { root.control-requested(1); }
            }
            Tile {
                x: 16px; y: 92px;
                glyph-size: 44px;
                icon: root.bt-on ? @image-url("assets/control_center/bt_active.png")
                    : @image-url("assets/control_center/bt.png");
                active: root.bt-on;
                requested => { root.control-requested(2); }
            }
            Tile {
                x: 120px; y: 92px;
                glyph-size: 38px;
                icon: @image-url("assets/control_center/batt.png");
                requested => { root.control-requested(3); }
            }
            Tile {
                x: 16px; y: 176px;
                glyph-size: 37px;
                icon: @image-url("assets/control_center/bellOn.png");
                requested => { root.control-requested(4); }
            }
            Tile {
                x: 120px; y: 176px;
                glyph-size: 37px;
                icon: @image-url("assets/control_center/vibOn.png");
                requested => { root.control-requested(5); }
            }
        }

        Rectangle {
            x: 248px;
            y: 48px;
            width: 208px;
            height: 190px;
            border-radius: 60px;
            background: Palette.card;
            Image {
                x: 34px; y: 8px;
                width: 139px; height: 139px;
                source: @image-url("assets/control_center/mpRing.png");
            }
            Image {
                x: 28px; y: 140px;
                width: 48px; height: 48px;
                source: @image-url("assets/control_center/prev.png");
            }
            Image {
                x: 80px; y: 140px;
                width: 48px; height: 48px;
                source: @image-url("assets/control_center/play.png");
            }
            Image {
                x: 132px; y: 140px;
                width: 48px; height: 48px;
                source: @image-url("assets/control_center/next.png");
            }
            // Official media plate launches Music; transport is not a player.
            TouchArea {
                clicked => {
                    if Math.abs(self.mouse-x - self.pressed-x) <= 12px
                        && Math.abs(self.mouse-y - self.pressed-y) <= 12px {
                        root.control-requested(6);
                    }
                }
            }
        }

        Rectangle {
            x: 24px;
            y: 334px;
            width: 208px;
            height: 112px;
            border-radius: 44px;
            background: Palette.card;
            Rectangle {
                x: 16px; y: 20px;
                width: 72px; height: 72px;
                // Unscanned slots are unknown. Keep the official L/R circle
                // silhouette while offering TEST; never fabricate EMPTY.
                if !root.has-slots: Rectangle {
                    width: 72px; height: 72px;
                    border-radius: 36px;
                    background: Palette.capsule;
                    Text {
                        y: 12px; width: 72px; height: 30px;
                        text: "L"; font-size: 24px;
                        color: Palette.text-2nd;
                        horizontal-alignment: center;
                    }
                    Text {
                        y: 43px; width: 72px; height: 20px;
                        text: "TEST"; font-size: 13px;
                        color: Palette.text-2nd;
                        horizontal-alignment: center;
                    }
                }
                if root.has-slots: Image {
                    width: parent.width; height: parent.height;
                    source: root.slot-l-icon;
                    image-fit: contain;
                }
                TouchArea {
                    clicked => {
                        if Math.abs(self.mouse-x - self.pressed-x) <= 12px
                            && Math.abs(self.mouse-y - self.pressed-y) <= 12px {
                            root.slot-requested(0);
                        }
                    }
                }
            }
            Rectangle {
                x: 120px; y: 20px;
                width: 72px; height: 72px;
                // Unscanned slots are unknown. Keep the official L/R circle
                // silhouette while offering TEST; never fabricate EMPTY.
                if !root.has-slots: Rectangle {
                    width: 72px; height: 72px;
                    border-radius: 36px;
                    background: Palette.capsule;
                    Text {
                        y: 12px; width: 72px; height: 30px;
                        text: "R"; font-size: 24px;
                        color: Palette.text-2nd;
                        horizontal-alignment: center;
                    }
                    Text {
                        y: 43px; width: 72px; height: 20px;
                        text: "TEST"; font-size: 13px;
                        color: Palette.text-2nd;
                        horizontal-alignment: center;
                    }
                }
                if root.has-slots: Image {
                    width: parent.width; height: parent.height;
                    source: root.slot-r-icon;
                    image-fit: contain;
                }
                TouchArea {
                    clicked => {
                        if Math.abs(self.mouse-x - self.pressed-x) <= 12px
                            && Math.abs(self.mouse-y - self.pressed-y) <= 12px {
                            root.slot-requested(1);
                        }
                    }
                }
            }
        }

        level-group := Rectangle {
            x: 248px;
            y: 254px;
            width: 208px;
            height: 192px;
            border-radius: 60px;
            background: Palette.card;
            volume-slider := VSlider {
                x: 16px; y: 20px;
                value: root.volume;
                icon: @image-url("assets/control_center/soundLow_active.png");
                changed(v) => { root.volume-changed(v); }
            }
            brightness-slider := VSlider {
                x: 120px; y: 20px;
                value: root.brightness;
                glyph-size: 32px;
                icon: @image-url("assets/control_center/sunSemi_active.png");
                changed(v) => { root.brightness-changed(v); }
            }
        }
        Rectangle {
            x: 220px; y: 430px;
            width: 40px; height: 40px;
            Image {
                x: 8px; y: 8px;
                width: 24px; height: 24px;
                source: @image-url("assets/icons/up_chevron.png");
            }
            TouchArea {
                clicked => {
                    if Math.abs(self.mouse-x - self.pressed-x) <= 12px
                        && Math.abs(self.mouse-y - self.pressed-y) <= 12px {
                        root.dismissed();
                    }
                }
            }
        }
    }
}
