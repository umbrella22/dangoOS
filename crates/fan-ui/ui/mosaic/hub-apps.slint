// Hub Apps 页 = 官方 launcher_flow_tab1
// 3×2 应用槽网格: settings/imu/album + tof/bricks/weather
// 槽位几何: 图标 118×118 @(0,0) + 官方标签 18px @(0,130)

import { Palette } from "palette.slint";

component AppSlot inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <int> app-id;
    callback open-app(int);
    width: 118px;
    height: 152px;

    Image {
        x: 0px;
        y: 0px;
        width: 118px;
        height: 118px;
        source: root.icon;
    }
    Text {
        x: 0px;
        y: 130px;
        width: 118px;
        height: 22px;
        text: root.label;
        font-size: 18px;
        color: Palette.text;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => {
            root.open-app(root.app-id);
        }
    }
}

export component HubApps inherits Rectangle {
    callback open-app(int); // 0=Settings 1=IMU 2=Album 4=TOF 3=Bricks 5=Weather
    width: 480px;
    height: 480px;

    AppSlot {
        x: 12px;
        y: 35px;
        icon: @image-url("assets/icons/settings.png");
        label: "Settings";
        app-id: 0;
        open-app(i) => {
            root.open-app(i);
        }
    }
    AppSlot {
        x: 180px;
        y: 35px;
        icon: @image-url("assets/icons/imu.png");
        label: "IMU";
        app-id: 1;
        open-app(i) => {
            root.open-app(i);
        }
    }
    AppSlot {
        x: 348px;
        y: 35px;
        icon: @image-url("assets/icons/album.png");
        label: "Album";
        app-id: 2;
        open-app(i) => {
            root.open-app(i);
        }
    }
    AppSlot {
        x: 12px;
        y: 237px;
        icon: @image-url("assets/icons/controller.png");
        label: "TOF";
        app-id: 4;
        open-app(i) => {
            root.open-app(i);
        }
    }
    AppSlot {
        x: 180px;
        y: 237px;
        icon: @image-url("assets/icons/bricks.png");
        label: "Bricks";
        app-id: 3;
        open-app(i) => {
            root.open-app(i);
        }
    }
    AppSlot {
        x: 348px;
        y: 237px;
        icon: @image-url("assets/icons/weather.png");
        label: "Weather";
        app-id: 5;
        open-app(i) => {
            root.open-app(i);
        }
    }
}
