// SPDX-License-Identifier: Apache-2.0
// Weather 页 = 官方 weather_480 场景(逐像素)
// 布局: 88px 温度 + 24px 天气描述 + 18px 城市 @左侧; 右侧 257px 天气插画层
// 底部预报条(423x40 卡): 日期 + 图标 + 低/高温
// 数据源(M4 架构): 官方天气 API —— Rust 生态 S31 WiFi 尚无 esp-wifi-sys,
// 接通前显示占位; WiFi 就绪后由 platform 层喂 weather-* 属性即可

import { Palette } from "palette.slint";

export component AppWeather inherits Rectangle {
    in property <string> temperature: "--";
    in property <string> condition: "Unavailable";
    in property <string> city: "Location unavail";
    // 天气类型: 0=unavailable 1=sunny 2=cloudy 3=overcast 4=snow 5=windy
    in property <int> art: 0;
    in property <string> date: "--/--";
    in property <string> low: "--";
    in property <string> high: "--";

    callback back-requested();

    width: 480px;
    height: 480px;
    background: Palette.screen-bg;

    // 页头
    Rectangle {
        x: 0px;
        y: 0px;
        width: 96px;
        height: 64px;
        Text {
            x: 24px;
            y: 8px;
            width: 48px;
            height: 48px;
            text: "‹";
            font-size: 36px;
            color: Palette.text-2nd;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.back-requested();
            }
        }
    }

    // 主数据(官方 @33,86 起)
    Text {
        x: 33px;
        y: 86px;
        width: 178px;
        height: 80px;
        text: root.temperature;
        font-size: 88px;
        color: #F9FAFB;
    }
    Text {
        x: 33px;
        y: 171px;
        width: 190px;
        height: 34px;
        text: root.condition;
        font-size: 24px;
        color: #F9FAFB;
    }
    Text {
        x: 33px;
        y: 204px;
        width: 190px;
        height: 26px;
        text: root.city;
        font-size: 18px;
        color: Palette.text-2nd;
    }

    // 天气插画(官方 219,64 261x176, 内图 257x257 @(4,-36))
    Image {
        x: 223px;
        y: 28px;
        width: 257px;
        height: 257px;
        source: root.art == 1 ? @image-url("assets/icons/sunny.png")
            : root.art == 2 ? @image-url("assets/icons/cloudy.png")
            : root.art == 3 ? @image-url("assets/icons/overcast.png")
            : root.art == 4 ? @image-url("assets/icons/snow.png")
            : root.art == 5 ? @image-url("assets/icons/windy.png")
            : @image-url("assets/icons/cloudy.png");
        visible: root.art > 0;
    }

    // 底部预报卡(官方 423x40 r? bg #181819; 居中放置)
    Rectangle {
        x: 28px;
        y: 400px;
        width: 423px;
        height: 40px;
        border-radius: 12px;
        background: Palette.card;
        Text {
            x: 16px;
            y: 8px;
            width: 112px;
            height: 24px;
            text: root.date;
            font-size: 24px;
            color: Palette.text-title;
        }
        Image {
            x: 104px + 12px;
            y: 8px;
            width: 24px;
            height: 24px;
            source: @image-url("assets/icons/forecast_cloudy.png");
        }
        Text {
            x: 275px;
            y: 8px;
            width: 58px;
            height: 24px;
            text: root.low;
            font-size: 24px;
            color: Palette.text-2nd;
        }
        Text {
            x: 349px;
            y: 8px;
            width: 58px;
            height: 24px;
            text: root.high;
            font-size: 24px;
            color: Palette.text;
        }
    }
}
