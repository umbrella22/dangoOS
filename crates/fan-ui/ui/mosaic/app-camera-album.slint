// 相机预览：运行时驱动完整帧/状态/重试，保留官方顶/底工具条
// NAND 照片保存未实现，快门保持禁用并标明 Preview only
// Album(M3 占位): 九宫格 grid, SPI NAND 接入后填充

import { Palette } from "palette.slint";

export component AppCamera inherits Rectangle {
    in property <image> frame;
    in property <bool> preview-ready: false;
    in property <string> status: "Camera preview unavailable";
    in property <bool> retry-available: false;
    callback back-requested();
    callback retry-requested();

    width: 480px;
    height: 480px;
    background: #000000;

    if root.preview-ready: Image {
        width: 480px;
        height: 480px;
        source: root.frame;
        image-fit: cover;
    }
    if !root.preview-ready: Text {
        x: 24px;
        y: 192px;
        width: 432px;
        height: 80px;
        text: root.status;
        font-size: 24px;
        color: Palette.text;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.preview-ready && root.retry-available: Rectangle {
        x: 180px;
        y: 288px;
        width: 120px;
        height: 48px;
        border-radius: 20px;
        background: Palette.card;
        Text {
            width: 100%;
            height: 100%;
            text: "Retry";
            font-size: 20px;
            color: Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { root.retry-requested(); }
        }
    }

    // 顶部工具条(官方 0,0 480x80 #3B3C3D opacity 160)
    Rectangle {
        x: 0px;
        y: 0px;
        width: 480px;
        height: 80px;
        background: #3B3C3D;
        opacity: 0.63;
    }
    // 返回
    Rectangle {
        x: 12px;
        y: 16px;
        width: 48px;
        height: 48px;
        Text {
            width: 100%;
            height: 100%;
            text: "‹";
            font-size: 36px;
            color: Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.back-requested();
            }
        }
    }

    // 底部工具条(官方 0,390 480x90)
    Rectangle {
        x: 0px;
        y: 390px;
        width: 480px;
        height: 90px;
        background: #3B3C3D;
        opacity: 0.63;
    }
    Text {
        x: 16px;
        y: 420px;
        width: 174px;
        height: 28px;
        text: "Preview only";
        font-size: 18px;
        color: Palette.text-2nd;
        vertical-alignment: center;
    }
    // 快门(官方 210,401 60x60)：保存尚未接入，不提供可触发操作。
    Rectangle {
        x: 210px;
        y: 401px;
        width: 60px;
        height: 60px;
        border-radius: 30px;
        background: Palette.text;
        border-width: 4px;
        border-color: Palette.text-2nd;
        opacity: 0.3;
    }
}

export component AppAlbum inherits Rectangle {
    in property <bool> has-storage: false;
    in property <int> photo-count: 0;
    callback back-requested();

    width: 480px;
    height: 480px;
    background: Palette.screen-bg;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 96px;
        height: 64px;
        Text {
            x: 24px;
            y: 8px;
            width: 48px;
            height: 48px;
            text: "‹";
            font-size: 36px;
            color: Palette.text-2nd;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.back-requested();
            }
        }
    }
    Text {
        x: 0px;
        y: 0px;
        width: 480px;
        height: 64px;
        text: "Album";
        font-size: 24px;
        color: Palette.text-2nd;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if !root.has-storage: Text {
        x: 24px;
        y: 216px;
        width: 432px;
        height: 48px;
        text: "Storage unavailable";
        font-size: 24px;
        color: Palette.text-2nd;
        horizontal-alignment: center;
    }
    // 九宫格占位(3×3, 官方 grid)
    for i in 9: Rectangle {
        x: 24px + Math.mod(i, 3) * 148px;
        y: 80px + Math.floor(i / 3) * 132px;
        width: 140px;
        height: 124px;
        border-radius: 12px;
        background: Palette.card;
        visible: root.has-storage && i < root.photo-count;
    }
}
