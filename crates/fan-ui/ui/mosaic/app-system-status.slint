// Concrete status pages for services whose hardware backend is not connected.
import { Palette } from "palette.slint";

export component StatusHeader inherits Rectangle {
    in property <string> title;
    callback back-requested();
    width: 480px;
    height: 72px;
    Text {
        x: 96px; y: 8px; width: 288px; height: 56px;
        text: root.title; font-size: 24px; color: Palette.text-2nd;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Rectangle {
        x: 24px; y: 24px; width: 64px; height: 48px;
        Text {
            width: 100%; height: 100%; text: "‹"; font-size: 36px;
            color: Palette.text-2nd; horizontal-alignment: center; vertical-alignment: center;
        }
        TouchArea { clicked => { root.back-requested(); } }
    }
}

export component StatusRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> enabled: true;
    callback clicked();
    width: 432px; height: 64px; border-radius: 20px; background: Palette.card;
    Text {
        x: 20px; y: 6px; width: 350px; height: 28px;
        text: root.title; font-size: 22px; color: Palette.text;
    }
    Text {
        x: 20px; y: 34px; width: 350px; height: 24px;
        text: root.detail; font-size: 16px; color: Palette.text-2nd;
    }
    Text {
        x: 384px; y: 10px; width: 28px; height: 40px;
        text: root.enabled ? "›" : ""; font-size: 26px; color: Palette.text-dim;
    }
    if root.enabled: TouchArea { clicked => { root.clicked(); } }
}

export component AppSystemStatus inherits Rectangle {
    // 0..5 = control center, 6 = Music, 7 = About, 8 = TOF, 9 = Interact.
    in property <int> feature: 0;
    callback back-requested();
    width: 480px; height: 480px; background: Palette.screen-bg;
    private property <string> heading: root.feature == 0 ? "Wi-Fi" : root.feature == 1 ? "Join"
        : root.feature == 2 ? "Bluetooth" : root.feature == 3 ? "Low Power"
        : root.feature == 4 ? "Ringtone" : root.feature == 5 ? "Vibration"
        : root.feature == 6 ? "Music" : root.feature == 7 ? "About"
        : root.feature == 8 ? "TOF" : "Interact";
    StatusHeader { x: 0px; y: 0px; title: root.heading; back-requested => { root.back-requested(); } }
    Text {
        x: 48px; y: 132px; width: 384px; height: 56px;
        text: root.feature == 7 ? "ESP-MOSAICO" : "Unavailable";
        font-size: 32px; color: Palette.text; horizontal-alignment: center;
    }
    Text {
        x: 48px; y: 204px; width: 384px; height: 112px;
        text: root.feature == 7 ? "Mosaic UI\nRust + Slint\n480 × 480 AMOLED"
            : root.feature == 0 ? "Wi-Fi is not connected.\nNetwork support is not available."
            : root.feature == 6 ? "Playback is not available\nin this firmware."
            : root.feature == 8 ? "TOF measurement is not available\nin this firmware."
            : root.feature == 9 ? "Interaction module testing is not available\nin this firmware."
            : root.heading + " is not available\nin this firmware.";
        font-size: 22px; color: Palette.text-2nd; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component AppSlotStatus inherits Rectangle {
    in property <int> side: 0;
    in property <string> camera-status;
    callback back-requested();
    callback test-requested(int);
    width: 480px; height: 480px; background: Palette.screen-bg;
    StatusHeader {
        x: 0px; y: 0px;
        title: root.side == 0 ? "Left Slot" : "Right Slot";
        back-requested => { root.back-requested(); }
    }
    Text {
        x: 48px; y: 84px; width: 384px; height: 28px;
        text: "Module not checked"; font-size: 18px;
        color: Palette.text-2nd; horizontal-alignment: center;
    }
    if root.side == 0: Text {
        x: 48px; y: 116px; width: 384px; height: 42px;
        text: "Camera status: " + root.camera-status;
        font-size: 16px; color: Palette.text-dim; wrap: word-wrap;
        horizontal-alignment: center;
    }
    StatusRow {
        x: 24px; y: 164px; title: "Camera";
        detail: root.side == 0 ? "Open preview test" : "Left slot only";
        enabled: root.side == 0;
        clicked => { root.test-requested(6); }
    }
    StatusRow {
        x: 24px; y: 236px; title: "TOF"; detail: "Not available in this firmware";
        clicked => { root.test-requested(8); }
    }
    StatusRow {
        x: 24px; y: 308px; title: "Interact"; detail: "Not available in this firmware";
        clicked => { root.test-requested(9); }
    }
    StatusRow {
        x: 24px; y: 380px; title: "IMU"; detail: "On-board sensor test";
        clicked => { root.test-requested(1); }
    }
}
