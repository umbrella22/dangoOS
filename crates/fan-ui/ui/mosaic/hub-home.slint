// Hub Home 页 = 官方 launcher_flow_tab0
// 布局坐标逐像素取自 hub 场景 JSON (docs/MOSAICO_UI_DESIGN.md)

import { Palette } from "palette.slint";

// Atelier 时钟 169×169: 四层同心圆环 + 指针
// (M1 静态 10:10 表位: 软渲染器不支持 Rectangle 运行时旋转, 用 Path 多边形;
//  M2 由 Rust 在 present 前直接画动态指针, 见 platform_mosaic)
component AtelierClock inherits Rectangle {
    width: 169px;
    height: 169px;
    border-radius: 20px;
    background: Palette.clock-face;

    Rectangle {
        x: 8px;
        y: 8px;
        width: 153px;
        height: 153px;
        border-radius: 13px;
        background: Palette.clock-ring-dark;
    }
    Rectangle {
        x: 9px;
        y: 9px;
        width: 151px;
        height: 151px;
        border-radius: 12px;
        background: Palette.clock-face;
    }
    Rectangle {
        x: 12px;
        y: 12px;
        width: 145px;
        height: 145px;
        border-radius: 10px;
        background: Palette.clock-ring-mid;
    }
    Rectangle {
        x: 13px;
        y: 13px;
        width: 143px;
        height: 143px;
        border-radius: 9px;
        background: Palette.clock-face;
    }
    // 分针(长, 60°=10:10 表位)
    Path {
        width: 169px;
        height: 169px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 169;
        viewbox-height: 169;
        commands: "M 85.3 85.9 L 138.1 55.4 L 136.5 52.6 L 83.7 83.1 Z";
        fill: Palette.clock-hand;
    }
    // 时针(短, 305°)
    Path {
        width: 169px;
        height: 169px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 169;
        viewbox-height: 169;
        commands: "M 85.5 83.0 L 45.4 54.9 L 43.3 57.9 L 83.5 86.0 Z";
        fill: Palette.clock-hand;
    }
    // 中心帽
    Rectangle {
        x: 81px;
        y: 81px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Palette.clock-hand;
    }
}

// 快捷图标: 118×118 图标 + 16px 标签(y=367)
component Shortcut inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked;
    width: 118px;
    height: 152px;

    Image {
        x: 0px;
        y: 0px;
        width: 118px;
        height: 118px;
        source: root.icon;
    }
    Text {
        x: 0px;
        y: 130px;
        width: 118px;
        height: 22px;
        text: root.label;
        font-size: 16px;
        color: Palette.text-title;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component HubHome inherits Rectangle {
    in property <string> weather-temp: "--";
    in property <string> weather-desc: "--";
    in property <string> weather-city: "--";
    callback open-shortcut(int); // 6=Camera 5=Weather 2=Album

    width: 480px;
    height: 480px;

    // 顶部大卡: 天气 + 时钟
    Rectangle {
        x: 13px;
        y: 10px;
        width: 454px;
        height: 209px;
        border-radius: 40px;
        background: Palette.hub-card;
        TouchArea {
            clicked => {
                if Math.abs(self.mouse-x - self.pressed-x) <= 12px
                    && Math.abs(self.mouse-y - self.pressed-y) <= 12px {
                    root.open-shortcut(5);
                }
            }
        }
    }

    // 天气文字和时钟在官方场景中直接归属于 launcher_flow_tab0。
    Text {
        x: 34px;
        y: 43px;
        width: 205px;
        height: 98px;
        text: root.weather-temp;
        font-size: 95px;
        color: Palette.text;
        font-family: "Noto Sans SC";
    }
    Text {
        x: 34px;
        y: 150px;
        width: 205px;
        height: 34px;
        text: root.weather-desc;
        font-size: 24px;
        color: Palette.text;
    }
    Text {
        x: 34px;
        y: 184px;
        width: 205px;
        height: 26px;
        text: root.weather-city;
        font-size: 18px;
        color: Palette.weather-city;
    }
    AtelierClock {
        x: 275px;
        y: 30px;
    }

    // 快捷行: Camera / Weather / Album
    Shortcut {
        x: 12px;
        y: 237px;
        icon: @image-url("assets/icons/camera.png");
        label: "Camera";
        clicked => {
            root.open-shortcut(6);
        }
    }
    Shortcut {
        x: 180px;
        y: 237px;
        icon: @image-url("assets/icons/weather.png");
        label: "Weather";
        clicked => {
            root.open-shortcut(5);
        }
    }
    Shortcut {
        x: 348px;
        y: 237px;
        icon: @image-url("assets/icons/album.png");
        label: "Album";
        clicked => {
            root.open-shortcut(2);
        }
    }
}
