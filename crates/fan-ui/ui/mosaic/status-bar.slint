// SPDX-License-Identifier: Apache-2.0
// 官方状态栏字形/轮廓；时间与图标向内12px，保留圆角屏安全余量。
// Official origins: time20, WiFi386, battery420; safe origins:32,374,408.
// 来源: scene_common.py status_bar() + hub 场景 JSON

import { Palette } from "palette.slint";

export component StatusBar inherits Rectangle {
    in property <string> time: "12:00";
    in property <int> wifi-level: 0; // 0=未连接, 1..4=RSSI 档
    in property <int> battery-pct: 80;
    in property <bool> charging: false;

    width: 480px;
    height: 64px;

    Text {
        x: 32px;
        y: 12px;
        width: 120px;
        height: 40px;
        text: root.time;
        font-size: 24px;
        color: Palette.text;
        font-family: "Noto Sans SC";
        vertical-alignment: center;
    }

    Image {
        x: 374px;
        y: 12px;
        width: 40px;
        height: 40px;
        source: root.wifi-level == 4 ? @image-url("assets/icons/status_wifi_4.png")
            : root.wifi-level == 3 ? @image-url("assets/icons/status_wifi_3.png")
            : root.wifi-level == 2 ? @image-url("assets/icons/status_wifi_2.png")
            : root.wifi-level == 1 ? @image-url("assets/icons/status_wifi_1.png")
            : @image-url("assets/icons/status_wifi_0.png");
    }

    Rectangle {
        x: 408px;
        y: 12px;
        width: 40px;
        height: 40px;

        // 电池轮廓(官方: 5,13 25x14 r4)
        Rectangle {
            x: 5px;
            y: 13px;
            width: 25px;
            height: 14px;
            border-radius: 4px;
            background: root.charging ? #101F12 : #171719;
            border-width: 1px;
            border-color: root.charging ? Palette.ok-green : Palette.text-2nd;
        }
        // 电量填充(官方: 8,16 20x8 r2, 连续比例填充)
        Rectangle {
            x: 8px;
            y: 16px;
            width: root.battery-pct / 100 * 20px;
            height: 8px;
            border-radius: 2px;
            background: root.charging ? Palette.ok-green
                : root.battery-pct < 15 ? Palette.danger : Palette.text;
        }
        // 极耳
        Rectangle {
            x: 33px;
            y: 17px;
            width: 2px;
            height: 6px;
            border-radius: 1px;
            background: root.charging ? Palette.ok-green : Palette.text-2nd;
        }
    }
}
