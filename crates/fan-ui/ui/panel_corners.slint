// Four short L-shaped marks over the panel's hairline border.
export component PanelCorners inherits Rectangle {
    in property <color> accent: #409EFF;
    private property <length> arm: 14px;
    private property <length> weight: 2px;

    Rectangle { x: 0; y: 0; width: root.arm; height: root.weight; background: root.accent; }
    Rectangle { x: 0; y: 0; width: root.weight; height: root.arm; background: root.accent; }
    Rectangle { x: parent.width - root.arm; y: 0; width: root.arm; height: root.weight; background: root.accent; }
    Rectangle { x: parent.width - root.weight; y: 0; width: root.weight; height: root.arm; background: root.accent; }
    Rectangle { x: 0; y: parent.height - root.weight; width: root.arm; height: root.weight; background: root.accent; }
    Rectangle { x: 0; y: parent.height - root.arm; width: root.weight; height: root.arm; background: root.accent; }
    Rectangle { x: parent.width - root.arm; y: parent.height - root.weight; width: root.arm; height: root.weight; background: root.accent; }
    Rectangle { x: parent.width - root.weight; y: parent.height - root.arm; width: root.weight; height: root.arm; background: root.accent; }
}
